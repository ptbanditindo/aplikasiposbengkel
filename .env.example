# ==============================================================================
# BENGKELPOS RADIATOR - ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Salin berkas ini menjadi .env lalu sesuaikan konfigurasi bengkel Anda.
# JANGAN meng-commit berkas .env yang berisi token atau rahasia ke repository publik!

# --- KONFIGURASI SERVER APLIKASI ---
APP_ENV=development
# Web lokal hanya untuk PC kasir ini. Jangan diganti ke IP LAN/0.0.0.0.
APP_HOST=127.0.0.1
APP_PORT=8000
# Web memakai PIN kasir (dibuat saat aplikasi pertama kali dibuka).
AUTH_MODE=session-pin
# Khusus build APK Android: token instalasi acak diisi otomatis oleh aplikasi.
# Biarkan kosong untuk versi web/desktop.
APP_INSTALL_TOKEN=

# --- BASIS DATA (SQLITE DEFAULT / POSTGRESQL OPSIONAL) ---
# Default menggunakan SQLite lokal agar portabel, cepat, dan single-file
DATABASE_URL=sqlite:///./data/bengkel_radiator.db

# --- IDENTITAS BENGKEL (DEFAULT; DAPAT DIUBAH DARI MENU PENGATURAN) ---
BENGKEL_NAMA=BENGKEL RADIATOR BERKAH
BENGKEL_TAGLINE=Spesialis Servis, Korok & Las Radiator Mobil/Alat Berat
BENGKEL_ALAMAT=Jl. Raya Otomotif No. 88, Jakarta
BENGKEL_TELEPON=0812-3456-7890
BENGKEL_WA=0812-3456-7890

# --- REKENING PEMBAYARAN TRANSFER BENGKEL (DEFAULT; DAPAT DIUBAH DARI MENU PENGATURAN) ---
BENGKEL_BANK_NAMA=BCA
BENGKEL_NO_REKENING=123-456-7890
BENGKEL_ATAS_NAMA=BENGKEL RADIATOR BERKAH

# --- KONFIGURASI PRINTER THERMAL BLUETOOTH (ESC/POS) ---
# Lebar kertas default: 58 (32 kolom) atau 80 (48 kolom)
PRINTER_PAPER_WIDTH=58
PRINTER_DEFAULT_ENCODING=CP437
PRINTER_AUTO_CUT=false
PRINTER_OPEN_DRAWER=false

# --- KEBIJAKAN GARANSI STANDAR BENGKEL ---
DEFAULT_GARANSI_BULAN=1
GARANSI_SYARAT_STANDAR=Garansi kebocoran berlaku pada titik pengerjaan las & penggantian tangki baru. Tidak berlaku jika overheat disebabkan kelalaian lain (kipas mati/termostat macet).

# --- DIREKTORI CADANGAN (BACKUP) ---
# Backup otomatis hanya dikirim lewat Telegram (lihat bagian di bawah);
# tidak ada penjadwal backup lokal.
BACKUP_DIR=./backups
# Jumlah file backup terakhir yang disimpan (file lebih lama dipangkas otomatis)
BACKUP_KEEP=14
# Batas ukuran berkas backup yang boleh diunggah untuk restore (MB)
BACKUP_MAX_RESTORE_MB=64

# --- BACKUP OTOMATIS TELEGRAM (DEFAULT; DAPAT DIISI DARI MENU PENGATURAN) ---
# Buat bot lewat @BotFather, lalu isi token & chat ID owner dari menu Pengaturan.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BACKUP_ENABLED=false
# Jam pengiriman harian (waktu lokal aplikasi)
TELEGRAM_BACKUP_TIME=21:00
