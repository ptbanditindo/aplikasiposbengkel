<?xml version="1.0" encoding="utf-8"?>
<!-- allowBackup=false sudah menonaktifkan Auto Backup. Aturan ini lapisan kedua
     untuk Android 12+ agar hash PIN dan database tidak ikut cloud backup/transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
